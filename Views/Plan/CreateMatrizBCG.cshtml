@model Proyecto_Red.Models.MatrizBCG

@{
    ViewData["Title"] = "Nueva Matriz BCG";
}

<div class="mb-4">
    <h1 class="display-6 fw-bold">Nueva Matriz BCG</h1>
    <p class="text-muted">Registra un producto o proceso para el análisis BCG.</p>
</div>

<form asp-action="CreateMatrizBCG" method="post">
    <div class="mb-3">
        <label asp-for="ProductoProceso" class="form-label">Producto o proceso</label>
        <input asp-for="ProductoProceso" class="form-control" />
        <span asp-validation-for="ProductoProceso" class="text-danger"></span>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="CrecimientoMercado" class="form-label">Crecimiento del mercado (%)</label>
            <input asp-for="CrecimientoMercado" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-6">
            <label asp-for="ParticipacionMercado" class="form-label">Participación de mercado (%)</label>
            <input asp-for="ParticipacionMercado" class="form-control" type="number" step="0.01" />
        </div>
    </div>
    <div class="mb-3 mt-3">
        <label asp-for="Clasificacion" class="form-label">Clasificación</label>
        <input asp-for="Clasificacion" class="form-control" />
        <span asp-validation-for="Clasificacion" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success"><i class="fas fa-save me-2"></i> Guardar BCG</button>
    <a asp-action="Analisis" class="btn btn-secondary ms-2">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
