@model Proyecto_Red.Models.MatrizCAME

@{
    ViewData["Title"] = "Nueva Matriz CAME";
}

<div class="mb-4">
    <h1 class="display-6 fw-bold">Nueva Matriz CAME</h1>
    <p class="text-muted">Registra las acciones de corregir, afrontar, mantener y explotar.</p>
</div>

<form asp-action="CreateCAME" method="post">
    <div class="mb-3">
        <label asp-for="Corregir" class="form-label">Corregir</label>
        <textarea asp-for="Corregir" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Afrontar" class="form-label">Afrontar</label>
        <textarea asp-for="Afrontar" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Mantener" class="form-label">Mantener</label>
        <textarea asp-for="Mantener" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Explotar" class="form-label">Explotar</label>
        <textarea asp-for="Explotar" class="form-control" rows="2"></textarea>
    </div>
    <button type="submit" class="btn btn-success"><i class="fas fa-save me-2"></i> Guardar CAME</button>
    <a asp-action="Analisis" class="btn btn-secondary ms-2">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
