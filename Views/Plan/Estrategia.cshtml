@model Proyecto_Red.ViewModels.PlanEstrategiaViewModel

@{
    ViewData["Title"] = "Estrategia";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 fw-bold">Estrategia del Plan</h1>
        <p class="text-muted">Gestiona misión, visión, valores, objetivos estratégicos y UEN.</p>
    </div>
    <div class="btn-group">
        <a asp-action="CreateMision" class="btn btn-outline-primary">Nueva misión</a>
        <a asp-action="CreateVision" class="btn btn-outline-primary">Nueva visión</a>
        <a asp-action="CreateValor" class="btn btn-outline-primary">Nuevo valor</a>
    </div>
</div>

<div class="row gy-4">
    <div class="col-lg-6">
        <div class="card p-4">
            <h5 class="mb-3">Misión</h5>
            @if (!Model.Misiones.Any())
            {
                <div class="text-muted">Aún no hay misión registrada.</div>
            }
            else
            {
                @foreach (var item in Model.Misiones)
                {
                    <div class="mb-3">
                        <p>@item.Descripcion</p>
                        <small class="text-muted">Registrado el @item.FechaRegistro.ToString("dd/MM/yyyy")</small>
                    </div>
                }
            }
        </div>

        <div class="card p-4 mt-4">
            <h5 class="mb-3">Valores</h5>
            @if (!Model.Valores.Any())
            {
                <div class="text-muted">Aún no hay valores definidos.</div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var item in Model.Valores)
                    {
                        <div class="list-group-item">
                            <h6 class="mb-1">@item.Nombre</h6>
                            <p class="mb-0">@item.Descripcion</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card p-4 mb-4">
            <h5 class="mb-3">Visión</h5>
            @if (!Model.Visiones.Any())
            {
                <div class="text-muted">Aún no hay visión registrada.</div>
            }
            else
            {
                @foreach (var item in Model.Visiones)
                {
                    <div class="mb-3">
                        <p>@item.Descripcion</p>
                        <small class="text-muted">Registrado el @item.FechaRegistro.ToString("dd/MM/yyyy")</small>
                    </div>
                }
            }
        </div>

        <div class="card p-4">
            <h5 class="mb-3">Objetivos Estratégicos</h5>
            @if (!Model.Objetivos.Any())
            {
                <div class="text-muted">Aún no hay objetivos estratégicos definidos.</div>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var item in Model.Objetivos)
                    {
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6>@item.Nombre</h6>
                                    <p class="mb-1">@item.Descripcion</p>
                                    <small class="text-muted">Meta: @item.Meta • Responsable: @item.Responsable</small>
                                </div>
                                <span class="badge bg-success">@item.Estado</span>
                            </div>
                        </li>
                    }
                </ul>
            }
            <div class="mt-3">
                <a asp-action="CreateObjetivo" class="btn btn-sm btn-primary">Agregar objetivo</a>
                <a asp-action="CreateUEN" class="btn btn-sm btn-outline-secondary ms-2">Agregar UEN</a>
            </div>
        </div>
    </div>
</div>
