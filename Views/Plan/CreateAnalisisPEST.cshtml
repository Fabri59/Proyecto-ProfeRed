@model Proyecto_Red.Models.AnalisisPEST

@{
    ViewData["Title"] = "Nuevo Análisis PEST";
}

<div class="mb-4">
    <h1 class="display-6 fw-bold">Nuevo Análisis PEST</h1>
    <p class="text-muted">Captura factores políticos, económicos, sociales y tecnológicos.</p>
</div>

<form asp-action="CreateAnalisisPEST" method="post">
    <div class="mb-3">
        <label asp-for="Politicos" class="form-label">Políticos</label>
        <textarea asp-for="Politicos" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Economicos" class="form-label">Económicos</label>
        <textarea asp-for="Economicos" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Sociales" class="form-label">Sociales</label>
        <textarea asp-for="Sociales" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Tecnologicos" class="form-label">Tecnológicos</label>
        <textarea asp-for="Tecnologicos" class="form-control" rows="2"></textarea>
    </div>
    <button type="submit" class="btn btn-success"><i class="fas fa-save me-2"></i> Guardar análisis</button>
    <a asp-action="Analisis" class="btn btn-secondary ms-2">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
