@model Proyecto_Red.Models.AnalisisInterno

@{
    ViewData["Title"] = "Nuevo Análisis Interno";
}

<div class="mb-4">
    <h1 class="display-6 fw-bold">Nuevo Análisis Interno</h1>
    <p class="text-muted">Registra las fortalezas y debilidades del entorno interno TI.</p>
</div>

<form asp-action="CreateAnalisisInterno" method="post">
    <div class="mb-3">
        <label asp-for="Fortalezas" class="form-label">Fortalezas</label>
        <textarea asp-for="Fortalezas" class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Debilidades" class="form-label">Debilidades</label>
        <textarea asp-for="Debilidades" class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="RecursosTecnologicos" class="form-label">Recursos tecnológicos</label>
        <textarea asp-for="RecursosTecnologicos" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="InfraestructuraTI" class="form-label">Infraestructura TI</label>
        <textarea asp-for="InfraestructuraTI" class="form-control" rows="2"></textarea>
    </div>
    <button type="submit" class="btn btn-success"><i class="fas fa-save me-2"></i> Guardar análisis</button>
    <a asp-action="Analisis" class="btn btn-secondary ms-2">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
