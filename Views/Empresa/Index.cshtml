@model IEnumerable<Proyecto_Red.Models.Empresa>

@{
    ViewData["Title"] = "Empresas";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="display-5 fw-bold text-dark mb-2">
            <i class="fas fa-building text-primary"></i> Gestión de Empresas
        </h1>
        <p class="text-muted">Administra la información de tus empresas</p>
    </div>
    <a class="btn btn-success btn-lg" href="@Url.Action("Create")">
        <i class="fas fa-plus-circle"></i> Nueva Empresa
    </a>
</div>

@if (Model.Any())
{
    <div class="card border-0">
        <div class="card-body">
            <table id="datatable" class="table table-hover">
                <thead>
                    <tr>
                        <th><i class="fas fa-briefcase"></i> Empresa</th>
                        <th><i class="fas fa-id-card"></i> RUC</th>
                        <th><i class="fas fa-industry"></i> Sector</th>
                        <th><i class="fas fa-calendar"></i> Período</th>
                        <th class="text-center"><i class="fas fa-cogs"></i> Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var empresa in Model)
                    {
                        <tr>
                            <td>
                                <strong>@empresa.Nombre</strong>
                                <br />
                                <small class="text-muted">@empresa.RazonSocial</small>
                            </td>
                            <td><kbd>@empresa.RUC</kbd></td>
                            <td>
                                @if (!string.IsNullOrEmpty(empresa.Sector))
                                {
                                    <span class="badge bg-info">@empresa.Sector</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(empresa.PeriodoEstrategico))
                                {
                                    <span class="badge bg-primary">@empresa.PeriodoEstrategico</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-info" href="@Url.Action("Details", new { id = empresa.Id })" title="Ver detalles">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", new { id = empresa.Id })" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = empresa.Id })" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info text-center py-5" role="alert">
        <i class="fas fa-inbox fa-3x mb-3 d-block text-muted"></i>
        <h5>No hay empresas registradas</h5>
        <p class="mb-0 text-muted">Crea una nueva empresa para comenzar</p>
    </div>
}
