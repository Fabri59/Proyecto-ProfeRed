@model Proyecto_Red.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-5">
    <h1 class="display-4 fw-bold text-dark mb-2">
        <i class="fas fa-tachometer-alt text-primary"></i> Dashboard Estratégico TI
    </h1>
    <p class="text-muted">Visualiza el progreso de tu plan estratégico en tiempo real</p>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="card-text opacity-75 mb-2"><i class="fas fa-file-alt"></i> Planes registrados</p>
                        <h2 class="display-5 fw-bold">@Model.TotalPlanes</h2>
                    </div>
                    <i class="fas fa-file-lines fa-3x opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card border-0 bg-gradient text-white" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="card-text opacity-75 mb-2"><i class="fas fa-bullseye"></i> Objetivos</p>
                        <h2 class="display-5 fw-bold">@Model.TotalObjetivos</h2>
                    </div>
                    <i class="fas fa-target fa-3x opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card border-0 bg-gradient text-white" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="card-text opacity-75 mb-2"><i class="fas fa-chess"></i> Estrategias</p>
                        <h2 class="display-5 fw-bold">@Model.TotalEstrategias</h2>
                    </div>
                    <i class="fas fa-chess-king fa-3x opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card border-0 bg-gradient text-white" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="card-text opacity-75 mb-2"><i class="fas fa-chart-pie"></i> Avance general</p>
                        <h2 class="display-5 fw-bold">@Model.PorcentajeAvance%</h2>
                    </div>
                    <i class="fas fa-percent fa-3x opacity-25"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0">
            <div class="card-header bg-light border-bottom">
                <h5 class="mb-0"><i class="fas fa-chart-doughnut text-primary"></i> Progreso general</h5>
            </div>
            <div class="card-body">
                <canvas id="progressChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0">
            <div class="card-header bg-light border-bottom">
                <h5 class="mb-0"><i class="fas fa-list text-primary"></i> Indicadores clave</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <div class="list-group-item px-0 py-3 border-0">
                        <div class="d-flex justify-content-between">
                            <span><i class="fas fa-file-alt text-primary"></i> Planes</span>
                            <strong class="badge bg-primary">@Model.TotalPlanes</strong>
                        </div>
                    </div>
                    <div class="list-group-item px-0 py-3 border-0">
                        <div class="d-flex justify-content-between">
                            <span><i class="fas fa-bullseye text-danger"></i> Objetivos</span>
                            <strong class="badge bg-danger">@Model.TotalObjetivos</strong>
                        </div>
                    </div>
                    <div class="list-group-item px-0 py-3 border-0">
                        <div class="d-flex justify-content-between">
                            <span><i class="fas fa-chess text-info"></i> Estrategias</span>
                            <strong class="badge bg-info">@Model.TotalEstrategias</strong>
                        </div>
                    </div>
                    <div class="list-group-item px-0 py-3 border-0">
                        <div class="d-flex justify-content-between">
                            <span><i class="fas fa-chart-pie text-success"></i> Avance</span>
                            <strong class="badge bg-success">@Model.PorcentajeAvance%</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const data = {
            labels: ['Completado', 'Pendiente'],
            datasets: [{
                label: 'Porcentaje de avance',
                data: [@Model.PorcentajeAvance, @(100 - Model.PorcentajeAvance)],
                backgroundColor: ['#667eea', '#e0e7ff'],
                borderColor: ['#667eea', '#e0e7ff'],
                borderWidth: 2
            }]
        };
        new Chart(document.getElementById('progressChart'), {
            type: 'doughnut',
            data: data,
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>
}
